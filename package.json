{
  "name": "ui-comc-service-package-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build --mode production",
    "preview:dev": "vite preview --mode st",
    "preview:prod": "vite preview --mode production",
    "deploy:prod": "npm run build:prod && echo 'Deploying...'",
    "preview": "npm run build && vite preview",
    "eslint": "eslint \"src/**/*.{js,jsx,ts,tsx,config.js}\" --cache --cache-location ./.cache/",
    "eslint:fix": "npm run eslint -- --fix",
    "fix:imports": "node scripts/fix-imports.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:all": "npm run fix:imports && npm run eslint:fix && npm run format"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "node scripts/fix-imports.js --staged",
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "**/*.{json,css,md,html}": [
      "prettier --write"
    ]
  },

  "dependencies": {
    "@admiral-ds/flags": "3.1.3",
    "@admiral-ds/fonts": "2.0.0",
    "@admiral-ds/icons": "4.7.0",
    "@admiral-ds/react-ui": "8.69.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-query-devtools": "5.104.2",
    "axios": "1.20.0",
    "d3": "7.9.0",
    "miragejs": "0.1.48",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-final-form": "7.0.1",
    "react-router-dom": "7.18.4",
    "styled-components": "5.3.11",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@faker-js/faker": "10.1.0",
    "@types/d3": "7.4.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.14.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/react-router-dom": "5.3.3",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.24.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.3.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "rollup-plugin-visualizer": "6.0.3",
    "ts-jest": "29.3.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.24.1",
    "uuid": "11.1.0",
    "vite": "6.2.6",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-minify": "2.1.0"
  }
}
